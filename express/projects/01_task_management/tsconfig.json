{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,

    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}