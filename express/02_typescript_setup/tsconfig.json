    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "strict": true,
        "moduleDetection": "force",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "outDir": "./dist"
