{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",

		"module": "nodenext",
		"moduleDetection": "force",
		"moduleResolution": "nodenext",
		"types": ["node"],

		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,

		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
