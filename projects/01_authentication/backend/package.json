{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"main": "src/server.ts",
	"scripts": {
		"dev": "docker compose up -d & tsx --watch src/server.ts",
		"start": "tsx dist/server.js",
		"build": "tsc",
		"format": "npx biome check --write --unsafe",
		"lint": "npx biome check",
		"db:generate": "npx drizzle-kit generate --config=src/db/drizzle.config.ts",
		"db:migrate": "npx drizzle-kit migrate --config=src/db/drizzle.config.ts",
		"db:studio": "npx drizzle-kit studio --config=src/db/drizzle.config.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"dotenv": "^18.0.8",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"tsx": "^4.23.15",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"pino-pretty": "^13.2.0"
	}
}
